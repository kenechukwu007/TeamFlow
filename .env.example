# Run npm run db:setup to generate working local database passwords.
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=false
SEED_DEMO=true
DATABASE_URL=postgresql://teamflow:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/teamflow
TEST_DATABASE_URL=postgresql://teamflow:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/teamflow_test

# Optional cache. Leave empty to read directly from PostgreSQL.
REDIS_URL=
CACHE_TTL_SECONDS=30
# Use a different prefix for each environment/database sharing a Redis server.
CACHE_PREFIX=teamflow:workspace:v1
# Optional asynchronous activity feed. Start the worker before enabling.
BROKER_ENABLED=false
AMQP_URL=
AMQP_QUEUE=teamflow.activity.v1
